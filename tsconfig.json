{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "resolveJsonModule": true,
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "@cucumber/cucumber"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
